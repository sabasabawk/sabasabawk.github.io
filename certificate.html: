<!DOCTYPE html>
<html>
<head>
<title>Certificate</title>

<style>
body{
    font-family: Arial;
    text-align: center;
    background: #f4f8fc;
    padding: 40px;
}

.box{
    background: white;
    padding: 30px;
    max-width: 700px;
    margin: auto;
    border-radius: 10px;
    box-shadow: 0 0 10px gray;
}

h1{
    color: #0066cc;
}
</style>
</head>

<body>

<div class="box">

<h1>🏆 Certificate of Completion</h1>

<p>You have completed the SDA History Course</p>

<h2>SABASABA Gospel Ministry</h2>

<p id="status"></p>

</div>

<script>
let completed = JSON.parse(localStorage.getItem("historyProgress")) || [];

if(completed.length >= 12){
    document.getElementById("status").innerHTML =
    "✅ Congratulations! You completed all lessons.";
} else {
    document.getElementById("status").innerHTML =
    "❌ You have completed " + completed.length + "/12 lessons.";
}
</script>

</body>
</html>